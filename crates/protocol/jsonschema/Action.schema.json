{
  "$defs": {
    "ActionId": {
      "description": "Opaque identifier of a dispatched action.",
      "type": "string"
    },
    "ActorId": {
      "description": "Opaque identifier of an actor (person, soul, or external participant).",
      "type": "string"
    },
    "Audience": {
      "description": "Set of actors that could perceive an event.",
      "items": {
        "$ref": "#/$defs/ActorId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "CapabilityId": {
      "description": "Opaque identifier of a declared body capability.",
      "type": "string"
    },
    "ChannelId": {
      "description": "Opaque identifier of a sensed effect channel.",
      "type": "string"
    },
    "CorrelationId": {
      "description": "Opaque correlation identifier linking an action and its outcome/reply.",
      "type": "string"
    },
    "HAct": {
      "description": "Canonical action digest `H_act` (`R-42`) binding approvals to exact action parameters.",
      "type": "string"
    },
    "OpaquePayload": {
      "description": "Opaque payload bytes carried unchanged through Core without interpretation.",
      "items": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "OriginActor": {
      "$ref": "#/$defs/ActorId",
      "description": "Actor that originated an event chain; inherited monotonically along `caused_by`."
    },
    "PlaceId": {
      "description": "Opaque identifier of a place where percepts originate or actions land.",
      "type": "string"
    },
    "ProtocolVersion": {
      "description": "Semantic major/minor protocol version carried by every message.",
      "properties": {
        "major": {
          "format": "uint16",
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "maximum": 0,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "SensedEffect": {
      "description": "Optional expected physical/sensor effect declared for a capability (`R-09`).",
      "properties": {
        "channel": {
          "$ref": "#/$defs/ChannelId"
        },
        "delta_pred": {
          "format": "double",
          "type": "number"
        },
        "noise": {
          "format": "double",
          "type": "number"
        },
        "window_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "channel",
        "window_ms",
        "noise",
        "delta_pred"
      ],
      "type": "object"
    },
    "Taint": {
      "description": "Monotonic minimum-trust provenance taint label (`Untrusted < Provisional < Trusted`).",
      "oneOf": [
        {
          "const": "untrusted",
          "description": "Lowest trust: external/unverified source or derived from one.",
          "type": "string"
        },
        {
          "const": "provisional",
          "description": "Intermediate trust: corroborated or provisional.",
          "type": "string"
        },
        {
          "const": "trusted",
          "description": "Highest trust: verified trusted origin.",
          "type": "string"
        }
      ]
    },
    "Time": {
      "description": "Millisecond timestamp from an injected clock (`u64` ms since epoch).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Outbound action emitted by Core toward a body capability.",
  "properties": {
    "action_id": {
      "$ref": "#/$defs/ActionId"
    },
    "audience": {
      "$ref": "#/$defs/Audience",
      "minItems": 1
    },
    "capability_id": {
      "$ref": "#/$defs/CapabilityId"
    },
    "correlation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorrelationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/SensedEffect"
        },
        {
          "type": "null"
        }
      ]
    },
    "h_act": {
      "anyOf": [
        {
          "$ref": "#/$defs/HAct"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin_actor": {
      "$ref": "#/$defs/OriginActor"
    },
    "payload": {
      "$ref": "#/$defs/OpaquePayload"
    },
    "places": {
      "items": {
        "$ref": "#/$defs/PlaceId"
      },
      "type": "array"
    },
    "protocol_version": {
      "$ref": "#/$defs/ProtocolVersion",
      "default": {
        "major": 1,
        "minor": 0
      }
    },
    "taint": {
      "$ref": "#/$defs/Taint"
    },
    "timestamp_ms": {
      "$ref": "#/$defs/Time"
    }
  },
  "required": [
    "action_id",
    "capability_id",
    "places",
    "audience",
    "origin_actor",
    "taint",
    "payload",
    "timestamp_ms"
  ],
  "title": "Action",
  "type": "object"
}
