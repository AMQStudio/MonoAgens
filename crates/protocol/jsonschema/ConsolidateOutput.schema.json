{
  "$defs": {
    "ActorId": {
      "description": "Opaque identifier of an actor (person, soul, or external participant).",
      "type": "string"
    },
    "CapabilityId": {
      "description": "Opaque identifier of a declared body capability.",
      "type": "string"
    },
    "CapabilitySchemaHash": {
      "description": "Deterministic hash of a capability's input/output schema (`R-38`).",
      "type": "string"
    },
    "DomainId": {
      "description": "Opaque identifier of a belief/expectation domain.",
      "type": "string"
    },
    "EventId": {
      "description": "Opaque monotonic event sequence identifier in the core log.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "PlaceId": {
      "description": "Opaque identifier of a place where percepts originate or actions land.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Typed outputs emitted during sleep consolidation (`consolidate`).",
  "oneOf": [
    {
      "properties": {
        "about_ids": {
          "items": {
            "$ref": "#/$defs/EventId"
          },
          "type": "array"
        },
        "consolidate_kind": {
          "const": "gist",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainId"
            },
            {
              "type": "null"
            }
          ]
        },
        "people": {
          "items": {
            "$ref": "#/$defs/ActorId"
          },
          "type": "array"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/PlaceId"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "consolidate_kind",
        "summary",
        "about_ids",
        "places",
        "people"
      ],
      "type": "object"
    },
    {
      "properties": {
        "consolidate_kind": {
          "const": "lesson",
          "type": "string"
        },
        "contrastive_success_ids": {
          "items": {
            "$ref": "#/$defs/EventId"
          },
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainId"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_ids": {
          "items": {
            "$ref": "#/$defs/EventId"
          },
          "type": "array"
        },
        "failure_signature": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        }
      },
      "required": [
        "consolidate_kind",
        "pattern",
        "failure_signature",
        "contrastive_success_ids",
        "failure_ids"
      ],
      "type": "object"
    },
    {
      "properties": {
        "capability_schema_hash": {
          "$ref": "#/$defs/CapabilitySchemaHash"
        },
        "consolidate_kind": {
          "const": "procedure",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/DomainId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "required_cap_ids": {
          "items": {
            "$ref": "#/$defs/CapabilityId"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "consolidate_kind",
        "name",
        "steps",
        "required_cap_ids",
        "capability_schema_hash"
      ],
      "type": "object"
    }
  ],
  "title": "ConsolidateOutput"
}
