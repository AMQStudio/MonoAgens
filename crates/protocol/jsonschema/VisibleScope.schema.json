{
  "$defs": {
    "ActorId": {
      "description": "Opaque identifier of an actor (person, soul, or external participant).",
      "type": "string"
    },
    "Audience": {
      "description": "Set of actors that could perceive an event.",
      "items": {
        "$ref": "#/$defs/ActorId"
      },
      "type": "array",
      "uniqueItems": true
    },
    "DeclassToken": {
      "description": "Explicit declassification token authorizing sharing specific event ids with a target (`R-33`).",
      "properties": {
        "expiry": {
          "$ref": "#/$defs/Time"
        },
        "issuer": {
          "$ref": "#/$defs/ActorId"
        },
        "scope": {
          "items": {
            "$ref": "#/$defs/EventId"
          },
          "type": "array"
        },
        "signature": {
          "type": "string"
        },
        "target_audience": {
          "$ref": "#/$defs/Audience"
        },
        "target_place": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "token_id": {
          "type": "string"
        }
      },
      "required": [
        "token_id",
        "issuer",
        "scope",
        "expiry",
        "target_audience",
        "signature"
      ],
      "type": "object"
    },
    "EventId": {
      "description": "Opaque monotonic event sequence identifier in the core log.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "PlaceId": {
      "description": "Opaque identifier of a place where percepts originate or actions land.",
      "type": "string"
    },
    "Time": {
      "description": "Millisecond timestamp from an injected clock (`u64` ms since epoch).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Pre-Step-5 privacy scope governing candidate recall and context assembly (`R-33`).",
  "properties": {
    "audience": {
      "$ref": "#/$defs/Audience"
    },
    "declass_tokens": {
      "items": {
        "$ref": "#/$defs/DeclassToken"
      },
      "type": "array"
    },
    "target_place": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlaceId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "audience"
  ],
  "title": "VisibleScope",
  "type": "object"
}
