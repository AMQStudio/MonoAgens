{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schedule definition for a recurring monitor expectation (`R-46`).",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "interval_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "interval_ms"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "cron": {
          "type": "string"
        }
      },
      "required": [
        "cron"
      ],
      "type": "object"
    }
  ],
  "title": "RecurrenceSchedule"
}
