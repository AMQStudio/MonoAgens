# Example environment for MonoAgens. Copy to .env and adjust.

# Postgres connection used by the kernel.
DATABASE_URL=postgresql://monoagens:monoagens@localhost:5433/monoagens

# Postgres connection used by the test suite (schema tests wipe nothing, but keep it separate).
TEST_DATABASE_URL=postgresql://monoagens:monoagens@localhost:5433/monoagens_test

# compose.yaml settings.
POSTGRES_DB=monoagens
POSTGRES_USER=monoagens
POSTGRES_PASSWORD=monoagens
POSTGRES_PORT=5433

# Telegram body (Step 3).
TELEGRAM_BOT_TOKEN=

# WhatsApp body (Part 1).
WHATSAPP_SESSION_DB=var/whatsapp.db

# CLI body: local Unix socket served by the main process, owner only.
CLI_SOCKET=/tmp/monoagens.sock

# Model provider: openai-compatible (default) | opencode-go.
LLM_PROVIDER=openai-compatible
# Primary provider model (for opencode-go, defaults to deepseek-v4.1-flash when unset).
LLM_MODEL=
# Optional ordered fallback providers, e.g. openai-compatible,opencode-go.
# Each fallback uses <PROVIDER>_API_KEY and <PROVIDER>_MODEL (e.g. OPENCODE_API_KEY, OPENCODE_MODEL).
LLM_FALLBACKS=
# OpenAI-compatible primary settings (used when LLM_PROVIDER=openai-compatible).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Optional: low | medium | high | max. Sent to the model only when set.
LLM_REASONING_EFFORT=
# Let one round carry several tool calls at once; LLM_PARALLEL_TOOL_CALLS=false disables it.
LLM_PARALLEL_TOOL_CALLS=true
# OpenCode Go key (used when LLM_PROVIDER=opencode-go or opencode-go is in LLM_FALLBACKS).
OPENCODE_API_KEY=
OPENCODE_MODEL=

# Replay tool (scripts/replay.py)
REPLAY_DATABASE_URL=postgresql://monoagens:monoagens@localhost:5433/monoagens_replay
